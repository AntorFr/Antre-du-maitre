{
  "name": "@antre-du-maitre/backend",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "tsx watch src/server.ts",
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "db:generate": "prisma generate",
    "db:migrate": "prisma migrate dev",
    "db:studio": "prisma studio",
    "db:seed": "prisma db seed",
    "drs:import": "node --import tsx src/scripts/import-drs-bestiary.ts",
    "drs:import:fixture": "node --import tsx src/scripts/import-drs-bestiary.ts --fixture"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^0.55.0",
    "@antre-du-maitre/shared": "0.1.0",
    "@fastify/cors": "^10.0.1",
    "@fastify/jwt": "^9.0.1",
    "@prisma/client": "^6.8.2",
    "bcrypt": "^5.1.1",
    "dotenv": "^16.5.0",
    "fastify": "^5.3.3",
    "pdfkit": "^0.17.1",
    "zod": "^3.25.23"
  },
  "devDependencies": {
    "@types/bcrypt": "^5.0.2",
    "@types/node": "^22.15.18",
    "@types/pdfkit": "^0.17.2",
    "prisma": "^6.8.2",
    "tsx": "^4.19.4",
    "typescript": "^5.8.3"
  },
  "prisma": {
    "seed": "node --import tsx prisma/seed.ts"
  }
}
