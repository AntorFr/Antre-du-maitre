DATABASE_URL=file:./dev.db
# LLM_PROVIDER : mock | anthropic | claude-agent
# - anthropic    : API Anthropic directe, facturée via ANTHROPIC_API_KEY.
# - claude-agent : Claude Agent SDK, consomme l'abonnement Claude (Pro/Max).
#   Auth : CLAUDE_CODE_OAUTH_TOKEN (généré une fois avec `claude setup-token`,
#   valable 1 an). En dev local, les credentials `claude login` de la machine
#   suffisent, pas besoin du token.
LLM_PROVIDER=mock
ANTHROPIC_API_KEY=
CLAUDE_CODE_OAUTH_TOKEN=
ANTHROPIC_MODEL=claude-sonnet-4-6
JWT_SECRET=change-me-in-development
PORT=3001
NODE_ENV=development
DEV_ADMIN_USERNAME=admin
DEV_ADMIN_PASSWORD=admin12345
DEV_CHILD_USERNAME=merlin
DEV_CHILD_PASSWORD=merlin12345

# SSO OIDC (Authelia) — optionnel : les 4 variables vont ensemble.
# Absentes -> login local seul (mode dev).
#OIDC_ISSUER=https://auth.berard.me
#OIDC_CLIENT_ID=merlin
#OIDC_CLIENT_SECRET=
#OIDC_REDIRECT_URI=https://merlin.berard.me/api/auth/oidc/callback
#OIDC_ADMIN_GROUP=parents
